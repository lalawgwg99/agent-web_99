{
  "name": "@jazzxx/agent-web",
  "version": "0.1.1",
  "description": "Unified web content fetching and browser automation for AI agents",
  "license": "MIT",
  "author": "lalawgwg99",
  "repository": {
    "type": "git",
    "url": "https://github.com/lalawgwg99/agent-web_99.git"
  },
  "keywords": [
    "mcp",
    "browser",
    "automation",
    "ai-agent",
    "web-scraping",
    "playwright",
    "snapshot",
    "claude",
    "cursor"
  ],
  "type": "module",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "bin": {
    "agent-web": "dist/bin/agent-web.js"
  },
  "exports": {
    ".": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "src/skills/SKILL.md",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@mozilla/readability": "^0.6.0",
    "commander": "^13.1.0",
    "rss-parser": "^3.13.0",
    "yaml": "^2.7.1",
    "zod": "^3.25.3"
  },
  "optionalDependencies": {
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
